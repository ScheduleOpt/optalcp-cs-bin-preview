<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Detect the NuGet RID for the current platform -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <_OptalCPBinRid>$(RuntimeIdentifier)</_OptalCPBinRid>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <_OptalCPBinRid Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x64</_OptalCPBinRid>
    <_OptalCPBinRid Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</_OptalCPBinRid>
    <!-- macOS: use NETCoreSdkRuntimeIdentifier if available, otherwise default to osx-arm64 -->
    <_OptalCPBinRid Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(NETCoreSdkRuntimeIdentifier)' != '' And $(NETCoreSdkRuntimeIdentifier.StartsWith('osx-'))">$(NETCoreSdkRuntimeIdentifier)</_OptalCPBinRid>
    <_OptalCPBinRid Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(_OptalCPBinRid)' == ''">osx-arm64</_OptalCPBinRid>
  </PropertyGroup>

  <!-- The name follows the target RID, not the build host, so that publishing
       for Windows from Linux still finds optalcp.exe: -->
  <PropertyGroup>
    <_OptalCPBinName>optalcp</_OptalCPBinName>
  </PropertyGroup>

  <!-- Only win-x64 is shipped for Windows. On Windows, an SDK-style .NET
       Framework project gets an inferred win-x86 RID (win7-x86 with the RID
       graph). An x86 process can still start the x64 solver, and so can an
       ARM64 one on Windows 11: -->
  <PropertyGroup Condition="$(_OptalCPBinRid.StartsWith('win'))">
    <_OptalCPBinRid>win-x64</_OptalCPBinRid>
    <_OptalCPBinName>optalcp.exe</_OptalCPBinName>
  </PropertyGroup>

  <!-- Copy the native binary to the output directory -->
  <ItemGroup Condition="'$(_OptalCPBinRid)' != ''">
    <None Include="$(MSBuildThisFileDirectory)..\runtimes\$(_OptalCPBinRid)\native\$(_OptalCPBinName)"
          Condition="Exists('$(MSBuildThisFileDirectory)..\runtimes\$(_OptalCPBinRid)\native\$(_OptalCPBinName)')"
          CopyToOutputDirectory="PreserveNewest"
          Link="$(_OptalCPBinName)" />
  </ItemGroup>

</Project>
